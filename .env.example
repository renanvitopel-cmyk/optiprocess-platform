# Copie este arquivo para backend/.env (desenvolvimento local) e preencha os valores.
# Em producao (Render), configure estas mesmas variaveis no painel do servico.
# NUNCA faca commit de um arquivo .env com valores reais.

# ------------------------------------------------------------------
# Ambiente
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# URL publica onde a plataforma fica acessivel (usada para montar o link do QR Code
# de validacao de certificado e o CORS). Em dev local: http://localhost:4000
PUBLIC_URL=http://localhost:4000

# ------------------------------------------------------------------
# Banco de dados (Neon Postgres)
# ------------------------------------------------------------------
# Use a connection string "pooled" do Neon (host termina em "-pooler"), nao a direta.
# Isso evita manter conexoes persistentes abertas, o que faz o Neon nunca hibernar
# e estoura a cota gratuita de CU-hrs. Ex.:
# postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/optiprocess?sslmode=require
DATABASE_URL=postgresql://usuario:senha@localhost:5432/optiprocess?schema=public

# ------------------------------------------------------------------
# Autenticacao
# ------------------------------------------------------------------
# Gere uma string aleatoria longa, ex.: openssl rand -base64 48
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=12h

# Usuario administrador inicial (criado automaticamente pelo seed/bootstrap se nao existir)
INITIAL_ADMIN_NAME=Administrador OptiProcess
INITIAL_ADMIN_EMAIL=admin@optiprocess.com.br
INITIAL_ADMIN_PASSWORD=troque-esta-senha

# ------------------------------------------------------------------
# Armazenamento de arquivos (laudos, certificados, fotos, produtos)
# ------------------------------------------------------------------
# "s3" = usa um bucket compativel com S3 (recomendado: Cloudflare R2, gratuito).
# "local" = grava em disco local, somente para desenvolvimento (Render tem disco efemero).
STORAGE_PROVIDER=local

# Necessario apenas quando STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=optiprocess-arquivos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------
# Integracoes leves (sem custo)
# ------------------------------------------------------------------
# Numero do WhatsApp comercial, formato internacional sem simbolos (ex.: 5515997847299)
WHATSAPP_NUMBER=5515997847299

# ------------------------------------------------------------------
# Seguranca
# ------------------------------------------------------------------
# Origens permitidas para CORS quando front e back rodam em portas separadas (dev).
CORS_ORIGIN=http://localhost:5173
